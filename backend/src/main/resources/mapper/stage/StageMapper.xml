<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.softwarego.selection.stage.mapper.StageMapper">

    <resultMap id="StageResultMap" type="com.softwarego.selection.stage.domain.Stage">
        <id column="id" property="id"/>
        <result column="stage_code" property="stageCode"/>
        <result column="stage_name" property="stageName"/>
        <result column="sort_no" property="sortNo"/>
        <result column="start_at" property="startAt"/>
        <result column="end_at" property="endAt"/>
    </resultMap>

    <select id="findAll" resultMap="StageResultMap">
        SELECT id, stage_code, stage_name, sort_no, start_at, end_at
        FROM stage
        ORDER BY sort_no
    </select>

    <select id="findAllForUpdate" resultMap="StageResultMap">
        SELECT id, stage_code, stage_name, sort_no, start_at, end_at
        FROM stage
        ORDER BY sort_no
        FOR UPDATE
    </select>

    <update id="updateTimes">
        UPDATE stage
        SET start_at = #{startAt},
            end_at = #{endAt}
        WHERE stage_code = #{stageCode}
    </update>
</mapper>
