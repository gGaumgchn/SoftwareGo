<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.softwarego.selection.user.mapper.UserMapper">

    <resultMap id="UserResultMap" type="com.softwarego.selection.user.domain.User">
        <id column="id" property="id"/>
        <result column="staff_no" property="staffNo"/>
        <result column="name" property="name"/>
        <result column="role" property="role"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <select id="findByStaffNoAndRole" resultMap="UserResultMap">
        SELECT id, staff_no, name, role, created_at, updated_at
        FROM sys_user
        WHERE staff_no = #{staffNo}
          AND role = #{role}
        LIMIT 1
    </select>

    <select id="findById" resultMap="UserResultMap">
        SELECT id, staff_no, name, role, created_at, updated_at
        FROM sys_user
        WHERE id = #{id}
    </select>

    <insert id="insert" parameterType="com.softwarego.selection.user.domain.User"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sys_user (staff_no, name, role)
        VALUES (#{staffNo}, #{name,jdbcType=VARCHAR}, #{role})
    </insert>
</mapper>
